# ══════════════════════════════════════════════════════════════════
# Open-mind — Git Ignore Configuration
# ══════════════════════════════════════════════════════════════════

# AI Models & Weights (Heavy files)
models/*
!models/.gitkeep
!models/README.md
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# Local User Data & SQLite Databases
data/*.db
data/*.db-shm
data/*.db-wal
data/*.db-journal
data/settings.json
data/cache/
data/outputs/
data/samples/
!data/.gitkeep
!data/demo_lecture.json

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Build Artifacts & Standalone Packaging
build/
dist/
*.spec
!OpenMind.spec
*.egg-info/
.eggs/

# IDE & OS Specific Files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.log

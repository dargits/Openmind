# ══════════════════════════════════════════════════════════════════
# Open-mind — Tệp Mẫu Cấu Hình Môi Trường (Environment Configuration)
# ══════════════════════════════════════════════════════════════════
# Sao chép tệp này thành .env để tùy biến các thông số hệ thống mà
# KHÔNG CẦN CHỈNH SỬA MÃ NGUỒN.

# Thư mục lưu trữ dữ liệu người dùng (SQLite DB, cấu hình, bản xuất)
# Mặc định: thư mục "data" bên trong dự án
OPENMIND_DATA_DIR=

# Thư mục lưu trữ trọng số mô hình AI (Whisper STT và Qwen LLM GGUF)
# Mặc định: thư mục "models" bên trong dự án
OPENMIND_MODELS_DIR=

# Cấu hình Mô hình Nhận diện giọng nói (Speech-to-Text)
# Lựa chọn kích thước: tiny | base | small | medium (Khuyên dùng: small)
OPENMIND_WHISPER_SIZE=small

# Thiết bị tính toán: cpu hoặc cuda (nếu máy có GPU NVIDIA)
OPENMIND_WHISPER_DEVICE=cpu

# Kiểu dữ liệu lượng tử hóa STT: int8 | float16 | float32
OPENMIND_WHISPER_COMPUTE_TYPE=int8

# Số luồng CPU sử dụng cho Whisper STT
OPENMIND_WHISPER_CPU_THREADS=8

# Cấu hình Mô hình Ngôn ngữ Lớn Cục bộ (LLM Qwen 2.5 3B)
# Tên file GGUF trong thư mục models
OPENMIND_LLM_MODEL=qwen2.5-3b-instruct-q4_k_m.gguf

# Chiều dài ngữ cảnh tối đa (tokens)
OPENMIND_LLM_CONTEXT_SIZE=4096

# Số luồng CPU xử lý suy luận LLM (khuyên dùng số nhân P-cores thực tế)
OPENMIND_LLM_THREADS=6

# ──────────────────────────────────────────────────────────────────
# Cấu hình Kiến trúc Lai: Tăng tốc Đám mây (Hybrid Engine)
# ──────────────────────────────────────────────────────────────────
# Chế độ hoạt động: local (cục bộ 100% offline) hoặc cloud (gọi API bên thứ 3)
OPENMIND_AI_ENGINE_MODE=local

# Nhà cung cấp Cloud: gemini hoặc openai_compatible (Groq, DeepSeek, OpenAI)
OPENMIND_CLOUD_PROVIDER=gemini

# Cấu hình Google Gemini (Khuyên dùng: gemini-1.5-flash / gemini-2.0-flash)
OPENMIND_GEMINI_API_KEY=
OPENMIND_GEMINI_MODEL=gemini-1.5-flash

# Cấu hình OpenAI Compatible (OpenAI, Groq, DeepSeek, OpenRouter)
OPENMIND_OPENAI_API_KEY=
OPENMIND_OPENAI_BASE_URL=https://api.openai.com/v1
OPENMIND_OPENAI_MODEL=gpt-4o-mini

# Chế độ kiểm thử gỡ lỗi giao diện (true | false)
OPENMIND_DEBUG=false

